{
  "name": "gizza-ai/chacha20-cipher",
  "version": "0.1.0",
  "interface": "handler@v1",
  "summary": "Encrypt or decrypt data with ChaCha20 or ChaCha20-Poly1305 (RFC 8439)",
  "role": "skill",
  "tool": {
    "description": "Encrypt or decrypt data with the ChaCha20 stream cipher or the ChaCha20-Poly1305 AEAD construction (RFC 8439). mode = stream or aead; key = 32 bytes, nonce = 12 bytes; optional AAD for aead.",
    "parameters": {
      "type": "object",
      "required": ["data", "key", "nonce"],
      "properties": {
        "data": { "type": "string" },
        "operation": { "type": "string", "enum": ["encrypt", "decrypt"], "default": "encrypt" },
        "key": { "type": "string" },
        "nonce": { "type": "string" },
        "aad": { "type": "string" },
        "mode": { "type": "string", "enum": ["stream", "aead"], "default": "stream" },
        "key_format": { "type": "string", "enum": ["text", "encoded"], "default": "text" },
        "counter": { "type": "integer", "default": 0, "minimum": 0 },
        "format": { "type": "string", "enum": ["hex", "base64"], "default": "hex" }
      },
      "additionalProperties": false
    }
  }
}
