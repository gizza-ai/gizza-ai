/target
/dist
/pkg
/node_modules
node_modules/
**/target
# Block crates resolve fresh (dev-time builds; deploys reuse committed wasm),
# but the deploy/CI-critical cargo roots commit their lockfiles so the
# wafer-run git deps can't float past the sha in wafer-run-pin.txt.
Cargo.lock
!/Cargo.lock
!/cli/Cargo.lock
!/block-utils/Cargo.lock

# Git worktrees
.worktrees/

# Local-dev cargo overrides — copy .cargo/config.toml.example to .cargo/config.toml
# to point wafer-* crate names at sibling working copies.
/.cargo/config.toml
.data/

# Playwright persistent-context cache (WebLLM model shards in OPFS/IndexedDB).
tests/.cache/
tests/test-results/
/test-results/


# Brainstorming companion mockups
.superpowers/

# native worktree tool
.claude/worktrees/

# per-tool web wasm build output
blocks/*/web/pkg/
blocks/*/web/target/

# Playwright MCP debug artifacts (console logs + page snapshots)
.playwright-mcp/

# Chrome partials generated by `emit_partials` at build time (see justfile's
# build-tools recipe) — head-extras.html is hand-authored and stays tracked.
site/partials/header.html
site/partials/footer.html
