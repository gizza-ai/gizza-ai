/target
/pkg
/node_modules
node_modules/
**/target
# Block build trees stay ignored because a full local baseline creates hundreds
# of them. For every NEW OR CHANGED block, Cargo.lock and target/block.wasm are
# intentional committed artifacts and must be staged explicitly with `git add
# -f`; scripts/build-block-wasm.sh prints the exact command. Existing blocks are
# migrated to this policy when next changed.
Cargo.lock
!/cli/Cargo.lock
!/block-utils/Cargo.lock

# Git worktrees
.worktrees/

# Local-dev cargo overrides — copy .cargo/config.toml.example to .cargo/config.toml
# to point wafer-* crate names at sibling working copies.
/.cargo/config.toml

# Playwright persistent-context cache (headed WebGPU/WebLLM specs, if any).
tests/.cache/
tests/test-results/

# Brainstorming companion mockups
.superpowers/

# native worktree tool
.claude/worktrees/

# Per-tool browser WASM is disposable build output. Never force-add web/pkg;
# CI/deploy rebuild it from web/src and the page generator copies it to /pkg.
blocks/*/web/pkg/
blocks/*/web/target/

# Playwright MCP debug artifacts (console logs + page snapshots)
.playwright-mcp/

# Local-dev runtime data (`gizza` serve/chat creates .data/ with a dev db + storage)
.data/
