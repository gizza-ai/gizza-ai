/target
/pkg
/node_modules
node_modules/
**/target
# Block crates resolve fresh (dev-time builds; the committed wasm is what
# ships), but the CI-critical cargo roots commit their lockfiles so the
# wafer-run git deps can't float past the sha in wafer-run-pin.txt.
Cargo.lock
!/cli/Cargo.lock
!/block-utils/Cargo.lock

# Git worktrees
.worktrees/

# Local-dev cargo overrides — copy .cargo/config.toml.example to .cargo/config.toml
# to point wafer-* crate names at sibling working copies.
/.cargo/config.toml

# Playwright persistent-context cache (headed WebGPU/WebLLM specs, if any).
tests/.cache/
tests/test-results/

# Brainstorming companion mockups
.superpowers/

# native worktree tool
.claude/worktrees/

# per-tool web wasm build output
blocks/*/web/pkg/
blocks/*/web/target/

# Playwright MCP debug artifacts (console logs + page snapshots)
.playwright-mcp/

# Local-dev runtime data (`gizza` serve/chat creates .data/ with a dev db + storage)
.data/
